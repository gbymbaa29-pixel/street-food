<!doctype html>
<html lang="mn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#111827">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Street Food">
<title>Street Food</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f3f4f6;color:#111827;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
header{background:#111827;color:#fff;padding:calc(16px + env(safe-area-inset-top)) 16px 16px}
header h1{margin:0;font-size:22px} header small{opacity:.72}
main{padding:12px;max-width:760px;margin:auto}
.card{background:#fff;border-radius:18px;padding:15px;margin-bottom:12px;box-shadow:0 2px 12px #0000000c}
h2{font-size:19px;margin:0 0 12px} h3{font-size:15px;margin:15px 0 10px}
input{width:100%;padding:13px;border:1px solid #d1d5db;border-radius:11px;font-size:16px}
.foods{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.food{border:2px solid #d1d5db;background:#fff;border-radius:12px;padding:8px;text-align:left;min-height:105px;cursor:pointer;display:flex;flex-direction:column;gap:7px}
.food.selected{border-color:#111827;background:#eef2ff;box-shadow:0 0 0 2px #11182722}
.food:active{transform:scale(.98)}
.food b{font-size:14px;line-height:1.2}.food span{color:#4b5563;font-size:14px}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 0;border-bottom:1px solid #eee}
.row button{border:0;border-radius:7px;padding:5px 10px;cursor:pointer}
.total{display:flex;justify-content:space-between;font-size:21px;font-weight:800;padding:14px 0}
.save{width:100%;padding:14px;border:0;border-radius:12px;background:#111827;color:#fff;font-weight:800;font-size:16px}
.container-row{display:flex;align-items:center;gap:12px;border:1px solid #e5e7eb;border-radius:12px;padding:10px 12px}
.container-btn{width:38px;height:38px;border:0;border-radius:9px;background:#eef0f3;font-size:22px}
.container-row strong{min-width:60px;text-align:center}.container-row span{margin-left:auto;font-weight:700}
.empty{text-align:center;color:#777;padding:18px 5px}
.report-title{display:flex;justify-content:space-between;align-items:center;gap:8px}.date{font-size:13px;color:#6b7280}
.report-controls{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:10px 0}
.period-btn{border:1px solid #d1d5db;background:#fff;border-radius:9px;padding:9px 4px;font-weight:700}
.period-btn.active{background:#111827;color:#fff}
.summary{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.stat{background:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;padding:11px;font-size:13px}.stat b{display:block;font-size:18px;margin-top:3px}
.food-stat,.payment-stat{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #eee}
.order{border:1px solid #e5e7eb;border-radius:13px;padding:13px;margin-top:10px}
.oh{display:flex;justify-content:space-between;gap:8px}.badge{font-size:11px;background:#fff7ed;color:#9a3412;padding:5px 7px;border-radius:20px;white-space:nowrap}
.order ul{padding-left:18px}.order li{margin:5px 0}.ot{text-align:right;font-size:18px;font-weight:800;border-top:1px solid #eee;padding-top:9px}
.actions{display:flex;gap:7px;margin-top:10px}.actions button{flex:1;border:0;border-radius:9px;padding:10px;font-weight:700}
.done{background:#dcfce7;color:#166534}.del{background:#fee2e2;color:#991b1b}
.pay-buttons{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:10px}
.pay-buttons button{border:1px solid #d1d5db;background:#fff;border-radius:9px;padding:10px 5px;font-weight:800}
.pay-buttons button.active{background:#111827;color:#fff}
.paid{margin-top:10px;padding:10px;border-radius:10px;background:#dcfce7;color:#15803d;font-weight:800}
.clear{border:0;background:#eef0f3;border-radius:9px;padding:8px 10px;float:right;font-weight:700}
.report-note{font-size:12px;color:#6b7280;margin-top:8px}
@media(max-width:380px){.foods{grid-template-columns:1fr}}
</style>
</head>
<body>
<header><h1>🍗 Street Food</h1><small>Захиалгын систем</small></header>
<main>
<section class="card">
<h2>Шинэ захиалга</h2>
<input id="customer" placeholder="Захиалагч / утас">
<h3>Хоол сонгох</h3>
<div class="foods" id="foods"></div>
<h3>🥡 Авч явах сав</h3>
<div class="container-row">
<button class="container-btn" onclick="changeContainer(-1)">−</button>
<strong id="containerQty">0 сав</strong>
<button class="container-btn" onclick="changeContainer(1)">+</button>
<span id="containerPrice">0₮</span>
</div>
<h3>Сонгосон хоол</h3>
<div id="cart" class="empty">Хоол сонгоно уу.</div>
<div class="total"><span>Нийт</span><span id="total">0₮</span></div>
<button class="save" onclick="saveOrder()">ЗАХИАЛГА ХАДГАЛАХ</button>
</section>

<section class="card">
<button class="clear" onclick="clearOrders()">Бүгдийг устгах</button>
<h2>📋 Одоогийн захиалгууд</h2>
<div id="orders"></div>
</section>

<section class="card">
<div class="report-title"><h2>📊 Өнөөдрийн тайлан</h2><div class="date" id="reportDate"></div></div>
<div class="report-controls">
<button class="period-btn active" onclick="showReport('today',this)">Өнөөдөр</button>
<button class="period-btn" onclick="showReport('yesterday',this)">Өчигдөр</button>
<button class="period-btn" onclick="showReport('week',this)">7 хоног</button>
<button class="period-btn" onclick="showReport('month',this)">Энэ сар</button>
</div>
<div class="summary">
<div class="stat">Нийт захиалга<b id="count">0</b></div>
<div class="stat">Нийт борлуулалт<b id="sales">0₮</b></div>
</div>
<h3>🍴 Хоол тус бүр</h3><div id="foodStats"></div>
<h3>💰 Төлбөрийн төрөл</h3><div id="paymentStats"></div>
</section>
</main>

<script>
const menu=[
{name:"Жижиг догбугги",price:4500},
{name:"Догбугги",price:7000},
{name:"Үдэн",price:3000},
{name:"Шарсан дог",price:3000},
{name:"Шарсан төмс",price:4000},
{name:"Наггетс",price:4000},
{name:"Шарсан төмстэй шаржигнуур тахиа",price:11000},
{name:"Чихэрлэг соустай догтой тахиа",price:13000}
];
const CONTAINER_PRICE=500;
let cart={},containerQty=0;
let orders=JSON.parse(localStorage.getItem("sf_orders")||"[]")||[];
let reports=JSON.parse(localStorage.getItem("sf_daily_reports")||"{}")||{};
const money=n=>Number(n||0).toLocaleString("mn-MN")+"₮";
const pad=n=>String(n).padStart(2,"0");
function key(d=new Date()){return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate())}
function textDate(d=new Date()){return d.getFullYear()+"."+pad(d.getMonth()+1)+"."+pad(d.getDate())}
function ensureReport(k){if(!reports[k]){reports[k]={orders:0,sales:0,items:{},payments:{Бэлэн:0,Данс:0,POS:0}};menu.forEach((_,i)=>reports[k].items[i]=0)}return reports[k]}
function renderFoods(){
 const box=document.getElementById("foods");
 box.innerHTML=menu.map((m,i)=>`<button type="button" class="food ${cart[i]?"selected":""}" onclick="add(${i})"><b>${m.name}</b><span>${money(m.price)}</span></button>`).join("");
}
function add(i){cart[i]=(cart[i]||0)+1;renderFoods();renderCart()}
function change(i,d){cart[i]=(cart[i]||0)+d;if(cart[i]<=0)delete cart[i];renderFoods();renderCart()}
function changeContainer(d){containerQty=Math.max(0,containerQty+d);document.getElementById("containerQty").textContent=containerQty+" сав";document.getElementById("containerPrice").textContent=money(containerQty*CONTAINER_PRICE);renderCart()}
function renderCart(){
 const box=document.getElementById("cart"),ks=Object.keys(cart);
 box.innerHTML=ks.length?ks.map(i=>`<div class="row"><span>${menu[i].name} × ${cart[i]}</span><span>${money(menu[i].price*cart[i])} <button onclick="change(${i},-1)">−</button><button onclick="change(${i},1)">+</button></span></div>`).join(""):'<div class="empty">Хоол сонгоно уу.</div>';
 const t=ks.reduce((s,i)=>s+menu[i].price*cart[i],0)+containerQty*CONTAINER_PRICE;
 document.getElementById("total").textContent=money(t);
}
function saveOrder(){
 const ks=Object.keys(cart);if(!ks.length){alert("Хоолоо сонгоно уу.");return}
 const items=ks.map(i=>({name:menu[i].name,qty:cart[i],unit:menu[i].price,sub:menu[i].price*cart[i],menuIndex:+i}));
 if(containerQty)items.push({name:"Авч явах сав",qty:containerQty,unit:CONTAINER_PRICE,sub:containerQty*CONTAINER_PRICE,menuIndex:null});
 const total=items.reduce((s,x)=>s+x.sub,0),k=key(),r=ensureReport(k);
 const o={id:Date.now(),customer:document.getElementById("customer").value.trim()||"Захиалагч",items,total,paymentStatus:"Төлөөгүй",paymentMethod:"",done:false,time:new Date().toLocaleString("mn-MN"),dateKey:k};
 orders.unshift(o);r.orders++;r.sales+=total;items.forEach(x=>{if(x.menuIndex!==null)r.items[x.menuIndex]=(r.items[x.menuIndex]||0)+x.qty});
 reports[k]=r;localStorage.setItem("sf_orders",JSON.stringify(orders));localStorage.setItem("sf_daily_reports",JSON.stringify(reports));
 cart={};containerQty=0;document.getElementById("customer").value="";document.getElementById("containerQty").textContent="0 сав";document.getElementById("containerPrice").textContent="0₮";renderFoods();renderCart();renderOrders();showReport("today",document.querySelector(".period-btn.active"));
}
function setPaid(id,method){
 const o=orders.find(x=>x.id===id);if(!o)return;
 o.paymentStatus="Төлсөн";o.paymentMethod=method;
 const r=ensureReport(o.dateKey);r.payments[method]=(r.payments[method]||0)+o.total;
 localStorage.setItem("sf_orders",JSON.stringify(orders));localStorage.setItem("sf_daily_reports",JSON.stringify(reports));renderOrders();renderReportsKeep();
}
function toggleDone(id){const o=orders.find(x=>x.id===id);if(o)o.done=!o.done;localStorage.setItem("sf_orders",JSON.stringify(orders));renderOrders()}
function removeOrder(id){orders=orders.filter(o=>o.id!==id);localStorage.setItem("sf_orders",JSON.stringify(orders));renderOrders()}
function clearOrders(){if(confirm("Одоогийн захиалгуудыг устгах уу? Тайлан устахгүй.")){orders=[];localStorage.setItem("sf_orders","[]");renderOrders()}}
function renderOrders(){
 const box=document.getElementById("orders");
 if(!orders.length){box.innerHTML='<div class="empty">Одоогоор захиалга алга.</div>';return}
 box.innerHTML=orders.map((o,n)=>`<div class="order">
 <div class="oh"><b>№${orders.length-n} — ${o.customer}</b><span class="badge">${o.done?"Дууссан":"Хүлээгдэж байна"}</span></div>
 <small>${o.time}</small><ul>${o.items.map(x=>`<li>${x.name} × ${x.qty} — <b>${money(x.sub)}</b></li>`).join("")}</ul>
 <div class="ot">Нийт: ${money(o.total)}</div>
 ${o.paymentStatus==="Төлсөн"?`<div class="paid">✓ Төлсөн — ${o.paymentMethod}</div>`:`<div class="pay-buttons"><button onclick="setPaid(${o.id},'Бэлэн')">💵 БЭЛЭН</button><button onclick="setPaid(${o.id},'Данс')">🏦 ДАНС</button><button onclick="setPaid(${o.id},'POS')">💳 POS</button></div>`}
 <div class="actions"><button class="done" onclick="toggleDone(${o.id})">${o.done?"↩ Буцаах":"✓ Дууссан"}</button><button class="del" onclick="removeOrder(${o.id})">Устгах</button></div>
 </div>`).join("");
}
function showReport(period,btn){
 document.querySelectorAll(".period-btn").forEach(x=>x.classList.remove("active"));if(btn)btn.classList.add("active");
 const now=new Date();now.setHours(0,0,0,0);let start=new Date(now),end=new Date(now);
 if(period==="yesterday"){start.setDate(start.getDate()-1);end=new Date(start)}
 if(period==="week"){start.setDate(start.getDate()-((start.getDay()+6)%7));end=new Date(start);end.setDate(end.getDate()+6)}
 if(period==="month"){start=new Date(now.getFullYear(),now.getMonth(),1);end=new Date(now.getFullYear(),now.getMonth()+1,0)}
 const a={orders:0,sales:0,items:{},payments:{Бэлэн:0,Данс:0,POS:0}};menu.forEach((_,i)=>a.items[i]=0);
 for(let d=new Date(start);d<=end;d.setDate(d.getDate()+1)){const r=reports[key(d)];if(!r)continue;a.orders+=r.orders||0;a.sales+=r.sales||0;menu.forEach((_,i)=>a.items[i]+=r.items?.[i]||0);a.payments.Бэлэн+=r.payments?.Бэлэн||0;a.payments.Данс+=r.payments?.Данс||0;a.payments.POS+=r.payments?.POS||0}
 document.getElementById("reportDate").textContent=start.getTime()===end.getTime()?textDate(start):textDate(start)+" – "+textDate(end);
 document.getElementById("count").textContent=a.orders;document.getElementById("sales").textContent=money(a.sales);
 document.getElementById("foodStats").innerHTML=menu.map((m,i)=>`<div class="food-stat"><span>${m.name}</span><b>${a.items[i]||0} ш</b></div>`).join("");
 document.getElementById("paymentStats").innerHTML=Object.entries(a.payments).map(([k,v])=>`<div class="payment-stat"><span>${k}</span><b>${money(v)}</b></div>`).join("");
}
function renderReportsKeep(){const b=document.querySelector(".period-btn.active");showReport("today",b)}
renderFoods();renderCart();renderOrders();showReport("today",document.querySelector(".period-btn.active"));
</script>
</body>
</html>
